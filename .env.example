# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is git-ignored, so your real key is never committed.
# NEVER put a real key in this file - it IS committed.

# --- Option A: local Ollama (free, no key) -------------------------------
# Run `ollama serve` and `ollama pull llama3.2` first.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# --- Option B: a hosted provider (requires a paid key) -------------------
# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# --- Option C: Google Gemini (OpenAI-compatible endpoint) ---------------
# Key from https://aistudio.google.com/apikey. Check the model name against
# Google's current model list - older names get retired.
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# --- Optional ------------------------------------------------------------
# EMBEDDING_MODEL=all-MiniLM-L6-v2
